{
 "$schema": "https://openapi.vercel.sh/vercel.json",
 "framework": null,
 "installCommand": "npm install --omit=dev --no-audit --no-fund",
 "buildCommand": "npm run build",
 "outputDirectory": "public",
 "redirects": [
  {
   "source": "/remote",
   "destination": "/#remote",
   "permanent": false
  },
  {
   "source": "/remote/:code",
   "destination": "/#remote",
   "permanent": false
  },
  {
   "source": "/turnering",
   "destination": "/#turnering",
   "permanent": false
  },
  {
   "source": "/overlay/tournament",
   "destination": "/#turnering",
   "permanent": false
  },
  {
   "source": "/display/tournament",
   "destination": "/#turnering",
   "permanent": false
  },
  {
   "source": "/overlay/turnering",
   "destination": "/#turnering",
   "permanent": false
  },
  {
   "source": "/display/turnering",
   "destination": "/#turnering",
   "permanent": false
  },
  {
   "source": "/tv",
   "destination": "/#tv",
   "permanent": false
  },
  {
   "source": "/obs",
   "destination": "/#overlay/1",
   "permanent": false
  },
  {
   "source": "/sponsor",
   "destination": "/#sponsor",
   "permanent": false
  },
  {
   "source": "/scoreboard",
   "destination": "/#scoreboard",
   "permanent": false
  },
  {
   "source": "/login",
   "destination": "/#login",
   "permanent": false
  },
  {
   "source": "/brugere",
   "destination": "/#brugere",
   "permanent": false
  },
  {
   "source": "/roller",
   "destination": "/#roller",
   "permanent": false
  },
  {
   "source": "/min-tavle",
   "destination": "/#min-tavle",
   "permanent": false
  },
  {
   "source": "/mig",
   "destination": "/#mig",
   "permanent": false
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  },
  {
   "source": "/",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/index.html",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/site.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/medier/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=300"
    }
   ]
  },
  {
   "source": "/roller.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  }
 ]
}