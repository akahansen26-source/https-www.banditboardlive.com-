  "IMPORT_PLAYERS":              { "group": "Turneringer", "label": "Importere spillere fra CSV/XLSX" },
  "EXPORT_RESULTS":              { "group": "Turneringer", "label": "Eksportere resultater (CSV, Excel, PDF)" },
  "MANAGE_LAYOUT":               { "group": "Turneringer", "label": "Administrere scoreboard-layout, designs, sponsorboards og medier" },
  "MANAGE_REMOTE":               { "group": "Turneringer", "label": "Administrere Remote Controller, TV/OBS-nøgle og enheder" },
  "MANAGE_SCOREBOARD_SETTINGS":  { "group": "Turneringer", "label": "Administrere scoreboard-indstillinger (borde, pointknapper, dart-input, grænser)" },
  "VIEW_AUDIT":                  { "group": "Turneringer", "label": "Se handlingsloggen" },
  "MANAGE_USERS":                { "group": "System",      "label": "Administrere brugere (oprette, redigere, deaktivere)" },
