  "MANAGE_PUBS":                 { "group": "System",      "label": "Administrere pubber og events" },
  "MANAGE_SETTINGS":             { "group": "System",      "label": "Administrere systemets almindelige indstillinger" },
  "MANAGE_SOCIAL":               { "group": "System",      "label": "Administrere sociale medier" },
  "MANAGE_ADMINS":               { "group": "Manager",     "label": "Oprette, ændre og fjerne administratorer" },
  "MANAGE_MANAGERS":             { "group": "Manager",     "label": "Oprette, ændre og fjerne administrator-managere" }
 },
 "roles": [
  { "id": "guest",    "name": "Gæst",                  "rank": 0, "summary": ["Offentlig visning", "Ingen scoreboard-adgang"],
    "permissions": ["VIEW_PUBLIC"] },
  { "id": "user",     "name": "Bruger",                "rank": 1, "summary": ["Egen tavle", "Personlige funktioner", "Ingen administration"],
    "inherits": "guest", "permissions": ["VIEW_OWN_BOARD"] },
  { "id": "scorer",   "name": "Scoreboard-admin",      "rank": 2, "summary": ["Køre live scoreboard", "Point, spillere, timer, kampe og turnering"],
    "inherits": "guest", "permissions": ["USE_SCOREBOARD", "EDIT_SCORE", "EDIT_PLAYER", "EDIT_TEAM", "EDIT_MATCH", "CONTROL_TIMER", "USE_REMOTE", "USE_OVERLAY"] },
  { "id": "scoremgr", "name": "Administrer scoreboard", "rank": 3, "summary": ["Alt scoreboard-admin kan", "Oprette og administrere turneringer og scoreboard-data"],
    "inherits": "scorer", "permissions": ["CREATE_TOURNAMENT", "EDIT_TOURNAMENT", "DELETE_TOURNAMENT", "MANAGE_PLAYERS", "IMPORT_PLAYERS", "EXPORT_RESULTS", "MANAGE_LAYOUT", "MANAGE_REMOTE", "MANAGE_SCOREBOARD_SETTINGS", "VIEW_AUDIT"] },
  { "id": "admin",    "name": "Admin",                 "rank": 4, "summary": ["Brugere, pubber, systemindstillinger og administration", "Kan ikke administrere andre administratorer eller managere"],
    "inherits": "scoremgr", "permissions": ["MANAGE_USERS", "MANAGE_ROLES", "MANAGE_PUBS", "MANAGE_SETTINGS", "MANAGE_SOCIAL"] },
  { "id": "manager",  "name": "Administrator-manager", "rank": 5, "summary": ["Fuld adgang", "Kan administrere administratorer og andre managere"],
    "permissions": ["*"] }
 ],
 "assign": {
  "_info": "Hvilken rettighed kræves for at oprette, ændre eller fjerne en bruger med denne rolle (ud over MANAGE_USERS).",
  "guest": "MANAGE_USERS", "user": "MANAGE_USERS", "scorer": "MANAGE_USERS", "scoremgr": "MANAGE_USERS",
  "admin": "MANAGE_ADMINS", "manager": "MANAGE_MANAGERS"
 }
}
